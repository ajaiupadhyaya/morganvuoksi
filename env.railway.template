# MorganVuoksi Terminal - Railway.app Environment Variables
# Copy these to your Railway project environment variables

# =============================================================================
# RAILWAY PLATFORM VARIABLES (Auto-configured)
# =============================================================================
# PORT - Automatically set by Railway (do not override)
# RAILWAY_PROJECT_ID - Automatically set by Railway
# RAILWAY_ENVIRONMENT - Automatically set by Railway

# =============================================================================
# STREAMLIT CONFIGURATION (Required for Railway)
# =============================================================================
STREAMLIT_SERVER_PORT=$PORT
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_FILE_WATCHER_TYPE=none

# =============================================================================
# FINANCIAL DATA API KEYS (Required for full functionality)
# =============================================================================
# Alpaca Trading API (Free account available)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Polygon.io Market Data (Free tier available)
POLYGON_API_KEY=your_polygon_api_key_here

# FRED Economic Data (Free registration required)
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage (Free tier available)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# =============================================================================
# AI & NLP API KEYS (Optional but recommended)
# =============================================================================
# OpenAI API (Required for AI analysis features)
OPENAI_API_KEY=your_openai_api_key_here

# News API (Free tier available)
NEWS_API_KEY=your_news_api_key_here

# =============================================================================
# DATABASE CONFIGURATION (Optional - Railway can provide)
# =============================================================================
# PostgreSQL Database URL (Railway can auto-provision)
DATABASE_URL=postgresql://user:password@host:port/database

# Redis Cache URL (Railway can auto-provision)
REDIS_URL=redis://host:port

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application settings
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# Security
SECRET_KEY=your_secret_key_here_make_it_long_and_random
ALLOWED_HOSTS=*

# Performance settings
WORKERS=1
MAX_REQUESTS=1000
TIMEOUT=30

# =============================================================================
# MEMORY & PERFORMANCE OPTIMIZATION (Railway Specific)
# =============================================================================
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable/disable features to optimize performance
ENABLE_ML_MODELS=true
ENABLE_REAL_TIME_DATA=true
ENABLE_AI_ANALYSIS=true
ENABLE_BACKTESTING=true
ENABLE_PORTFOLIO_OPTIMIZATION=true

# =============================================================================
# INSTRUCTIONS FOR RAILWAY DEPLOYMENT
# =============================================================================
# 1. Copy the required variables to your Railway project dashboard
# 2. Replace placeholder values with your actual API keys
# 3. Railway will automatically handle PORT and other platform variables
# 4. For database services, connect Railway add-ons (PostgreSQL, Redis)
# 5. Test deployment with free tier API keys first 